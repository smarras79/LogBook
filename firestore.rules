rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true when the requesting user is the designated admin
    // (identified by email token, OR by isAdmin flag stored in their own doc).
    function isAdminUser() {
      return request.auth != null && (
        request.auth.token.email == 'simone.marras@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // Each user can read/write their own document.
    // Admin can read/write any user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdminUser();
    }

    // Public leaderboard stats — readable by any authenticated user,
    // writable only by the owning user or an admin.
    match /publicStats/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == userId || isAdminUser());
    }

    // Flight matching registry — any authenticated user can read/write.
    match /flightRegistry/{docId} {
      allow read, write: if request.auth != null;
    }

    // Chat messages — any authenticated user can read/write.
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
  }
}
